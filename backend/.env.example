# Copy to .env and adjust. Never commit the real .env.
NODE_ENV=development
PORT=3000

# Postgres (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://chat:chat@localhost:5432/chat?schema=public

# Redis: presence, rate limits, Socket.IO adapter pub/sub
REDIS_URL=redis://localhost:6379

# Auth. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-chars
JWT_ACCESS_TTL=900
REFRESH_TTL=2592000
# Only needed when the web app is served from a different site (not just a different port).
COOKIE_SECURE=false

# Comma-separated browser origins allowed to call the API and open sockets
CORS_ORIGINS=http://localhost:5173
